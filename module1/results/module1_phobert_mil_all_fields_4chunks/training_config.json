  "encoder_lr": 2e-05,
  "head_lr": 0.0001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "freeze_bottom_layers": 6,
  "gradient_checkpointing": false,
  "num_workers": 2,
  "random_seed": 20260918
}